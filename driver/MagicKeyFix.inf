[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderName%
DriverVer=09/10/2026,1.0.0.0
CatalogFile=MagicKeyFix.cat
PnpLockdown=1

[ControlFlags]
ExcludeFromSelect=*

[DestinationDirs]
DefaultDestDir=13
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
MagicKeyFix.sys=1

[Manufacturer]
%ManufacturerName%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceName%=USB_Install,USB\VID_05AC&PID_0267&MI_01
%DeviceName%=BTH_Install,BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0267

[DriverCopy]
MagicKeyFix.sys

[LowerFilter_AddReg]
HKR,,LowerFilters,0x00010008,"MagicKeyFix"

[USB_Install.NT]
Include=Input.inf
Needs=HID_Inst.NT
CopyFiles=DriverCopy

[USB_Install.NT.HW]
AddReg=LowerFilter_AddReg

[USB_Install.NT.Services]
Include=Input.inf
Needs=HID_Inst.NT.Services
AddService=MagicKeyFix,,Service_Install

[BTH_Install.NT]
Include=hidbth.inf
Needs=HIDBTH_Inst.NT
CopyFiles=DriverCopy

[BTH_Install.NT.HW]
Include=keyboard.inf
Needs=HID_Keyboard_Inst.NT.HW
AddReg=LowerFilter_AddReg

[BTH_Install.NT.Services]
Include=hidbth.inf
Needs=HIDBTH_Inst.NT.Services
AddService=MagicKeyFix,,Service_Install

[Service_Install]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\MagicKeyFix.sys

[Strings]
ProviderName="MagicKeyFix"
ManufacturerName="MagicKeyFix"
DeviceName="Apple Magic Keyboard A1644 - MagicKeyFix"
ServiceName="MagicKeyFix A1644 HID filter"
DiskName="MagicKeyFix Driver Disk"
